# Cesium Ion Access Token (Optional)
# If left blank, the application gracefully operates using OpenStreetMap imagery and WGS84 Ellipsoid / Cesium terrain fallback
VITE_CESIUM_ION_TOKEN=

# Default Coordinate Overrides (optional)
VITE_DEFAULT_LATITUDE=16.9984
VITE_DEFAULT_LONGITUDE=81.7774
VITE_DEFAULT_HEIGHT=1200
